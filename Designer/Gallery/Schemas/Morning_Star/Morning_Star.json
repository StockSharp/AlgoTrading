                  "Pattern": {
                    "Value": {
                      "PatternName": "Morning Star Reversal",
                      "Pattern": {
                        "type": "StockSharp.Algo.Candles.Patterns.ExpressionCandlePattern, StockSharp.Algo",
                        "settings": {
                          "Name": "Morning Star Reversal",
                          "Conditions": [
                            {
                              "Expression": "(O > C) && (B > 0)"
                            },
                            {
                              "Expression": "B < pB * 0.5m"
                            },
                            {
                              "Expression": "(O < C) && (C > (ppH + ppL) / 2)"
                            }
                          ]
                        }
                      }
                    }
                  }
                }
