<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\common.props" />
  <PropertyGroup>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <NoWarn>RS1036;RS1038</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Ecng.UnitTesting" Version="$(EcngVer)" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="$(MsTestSdkVer)" />
    <PackageReference Include="MSTest.TestAdapter" Version="$(MsTestVer)" />
    <PackageReference Include="MSTest.TestFramework" Version="$(MsTestVer)" />
    <PackageReference Include="StockSharp.Samples.HistoryData" Version="$(StockSharpVer)" />
      <Compile Include="../API/*/1807_GO/CS/*.cs" Link="CS\%(Filename)%(Extension)" />
    <Compile Include="../API/*/3299_JB/CS/*.cs" Link="CS\%(Filename)%(Extension)" />
    <Compile Include="../API/*/3122_Vlado/CS/*.cs" Link="CS\%(Filename)%(Extension)" />
    <Compile Include="../API/*/1788_Timer/CS/*.cs" Link="CS\%(Filename)%(Extension)" />
    <Compile Include="../API/*/3114_LBS/CS/*.cs" Link="CS\%(Filename)%(Extension)" />
    <Compile Include="../API/*/3121_Bruno/CS/*.cs" Link="CS\%(Filename)%(Extension)" />
    <Compile Include="../API/*/1276_RSI/CS/*.cs" Link="CS\%(Filename)%(Extension)" />
    <Compile Include="../API/*/1228_RCI/CS/*.cs" Link="CS\%(Filename)%(Extension)" />
    <Compile Include="../API/*/1243_Renko/CS/*.cs" Link="CS\%(Filename)%(Extension)" />
    <Compile Include="../API/*/1322_SMC/CS/*.cs" Link="CS\%(Filename)%(Extension)" />
    <Compile Include="../API/*/1437_Time/CS/*.cs" Link="CS\%(Filename)%(Extension)" />
    <Compile Include="../API/*/1341_Stochastic/CS/*.cs" Link="CS\%(Filename)%(Extension)" />
    <Compile Include="../API/*/1189_Price_Flip/CS/*.cs" Link="CS\%(Filename)%(Extension)" />
    <Compile Include="../API/*/4104_Pinball_Machine_Random_Draw/CS/*.cs" Link="CS\%(Filename)%(Extension)" />
</ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(StockSharpDir)Algo.Indicators\Algo.Indicators.csproj" />
    <ProjectReference Include="$(StockSharpDir)Algo.Strategies\Algo.Strategies.csproj" />
    <ProjectReference Include="$(StockSharpDir)Algo.Compilation\Algo.Compilation.csproj" />
    <ProjectReference Include="$(StockSharpDir)Diagram.Core\Diagram.Core.csproj" />
  </ItemGroup>
  <!--
    Overridden examples compiled into the test assembly so that their tests can reach the
    strategy's own type. Each key is also in StrategyInventory.Overrides, which keeps it out of
    the generated rows; an override whose tests run the example by path needs no entry here.
  -->
  <ItemGroup>
    <Compile Include="../API/*/0333_Keltner_Seasonal_Filter/CS/*.cs" Link="CS\%(Filename)%(Extension)" />
    <Compile Include="../API/*/0503_Advanced_Position_Management/CS/*.cs" Link="CS\%(Filename)%(Extension)" />
    <Compile Include="../API/*/1908_Random_Trailing_Stop/CS/*.cs" Link="CS\%(Filename)%(Extension)" />
    <Compile Include="../API/*/2101_Linear_Regression_Slope_V1/CS/*.cs" Link="CS\%(Filename)%(Extension)" />
    <Compile Include="../API/*/2703_Self_Optimizing_RSI_or_MFI_Trader_v3/CS/*.cs" Link="CS\%(Filename)%(Extension)" />
    <Compile Include="../API/*/2776_CH2010_Structure/CS/*.cs" Link="CS\%(Filename)%(Extension)" />
    <Compile Include="../API/*/3623_Matrix_Machine_Learning/CS/*.cs" Link="CS\%(Filename)%(Extension)" />
    <Compile Include="../API/*/4006_TenPips_Opposite_Last_N_Hour_Trend/CS/*.cs" Link="CS\%(Filename)%(Extension)" />
  </ItemGroup>
  <!--
    Nothing else under API reaches the compiler. The tests enumerate the examples on disk at run
    time and compile each one through CodeInfo, so the 3800 example classes never enter this
    compilation and no source generator has to emit a method per strategy.
  -->
</Project>
